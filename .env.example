# Russian Roulette local development environment variables example.
# Copy to .env to configure local runs:
#   cp .env.example .env

# Server mode: local | public
ROULETTE_SERVER_MODE=local

# Local execution settings
ROULETTE_HTTP_HOST=127.0.0.1
ROULETTE_HTTP_PORT=8787
ROULETTE_LAN_EXPOSED=false
ROULETTE_FOUNDER_PASSWORD=local-only

# Public mode settings (when ROULETTE_SERVER_MODE=public)
# ROULETTE_ADMIN_TOKEN=your_secure_admin_token_here
# ROULETTE_PUBLIC_BASE_URL=https://rrt.akiai.asia
