# Russian Roulette public backend environment variables example.
# Copy to .env and adjust variables as needed:
#   cp .env.example .env
# Installed to: ~/srv/apps/roulette/services/roulette-backend/.env
#
# Container loads this file automatically on startup.

ROULETTE_ENV=production
ROULETTE_SERVER_MODE=public
ROULETTE_HTTP_HOST=0.0.0.0
ROULETTE_HTTP_PORT=8080
ROULETTE_ADMIN_TOKEN=your_secure_admin_token_here
ROULETTE_PUBLIC_BASE_URL=https://rrt.akiai.asia
ROULETTE_LOG_LEVEL=info
ROULETTE_RUNTIME_DIR=/app/runtime
